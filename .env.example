# UrbanSense — copy to .env. Never commit secrets.

APP_NAME=UrbanSense
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
FIELD_TOKEN_EXPIRE_MINUTES=45
ALGORITHM=HS256
DEMO_API_ENABLED=true

DATABASE_URL=postgresql+psycopg://urbansense:urbansense@localhost:5432/urbansense
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175

# Local demo: keep DEMO_SEED_ON_START=true. For a clean empty city, set false.
# No OpenAI / Gemini / Azure AI key is required. YOLO and ANPR run locally.
# Phone on LAN: run uvicorn --host 0.0.0.0 and set Flutter API_BASE to this PC's Wi-Fi IP.

EVIDENCE_DIR=./storage/evidence
PUBLIC_BASE_URL=http://localhost:8000

# Fusion (deterministic, replaceable)
FUSION_MAX_DISTANCE_METERS=40
FUSION_MAX_TIME_SECONDS=21600
FUSION_COMPATIBLE_ONLY=true

# Road health weights (rule-based, transparent)
HEALTH_DEFECT_PENALTY=8
HEALTH_SEVERITY_HIGH=12
HEALTH_RECURRENCE_PENALTY=5
HEALTH_TRAFFIC_WEIGHT=0.02
HEALTH_PEDESTRIAN_WEIGHT=0.03

DEMO_SEED_ON_START=true

# Azure (optional locally). On App Service these come from managed identity + Bicep.
# AZURE_VISION_ENDPOINT=https://cvxxxxx.cognitiveservices.azure.com/
# AZURE_STORAGE_ACCOUNT_URL=https://stxxxxx.blob.core.windows.net
# AZURE_STORAGE_CONTAINER=evidence
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# AZURE_OPENAI_ENDPOINT=https://oaixxxxx.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_CONTENTSAFETY_ENDPOINT=https://csxxxxx.cognitiveservices.azure.com/

# Composio officer ping on FLEET_CONFIRMED (not YOLO).
# COMPOSIO_API_KEY=
# COMPOSIO_NOTIFY_TO=officer@example.com
# COMPOSIO_NOTIFY_CHANNEL=gmail
# COMPOSIO_ENTITY_ID=default
# COMPOSIO_CONNECTED_ACCOUNT_ID=

