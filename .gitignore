# ---- secrets and local config ----
.env
.env.local
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.venv-train/
venv/

# ---- Node / dashboard build output ----
node_modules/
dist/
build/
backend/static_dash/
dashboard/public/ort/
dashboard/public/weights/*.onnx

# ---- datasets, models and experiment output (large, never in git) ----
# data/ holds the raw and prepared datasets. Only its README is tracked.
data/*
!data/README.md
# Weights and training runs under ml/models. The deployed ONNX lives ONLY at backend/app/weights/rdd_india.onnx
# (tracked) and is copied to dashboard/public/weights/rdd_web.onnx at vite dev/build time.
ml/models/**/*.pt
ml/models/**/*.onnx
ml/models/**/runs/
ml/models/base/
# Reference repos that were used as a component library. Not part of the product.
third_party/
*.part
*.sep5
# Strays at the repo root (auto-downloads, experiments)
/*.pt
/*.onnx

# ---- Windows launcher (built by deploy/windows/build-exe.bat) ----
/SadakSaarthi.exe

# ---- runtime and local data ----
storage/evidence/*
!storage/evidence/.gitkeep
storage/backups/
*.db
*.sqlite
*.log
coverage/
htmlcov/
.azure/*/
!.azure/deployment-plan.md

# ---- editors, AI tools and OS files (local only) ----
.claude/
.opencode/
.impeccable/
.cursor/
.idea/
.vscode/
opencode.json
.DS_Store
._*

# Keep the deployment ONNX and its docs tracked even though they sit under weights/.
!backend/app/weights/rdd_india.onnx
!backend/app/weights/README.md
!backend/app/weights/.gitkeep
