      "metadata": {
        "description": "azd environment name"
      }
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "metadata": {
        "description": "Azure region for the resource group and most resources"
      }
    }
  },
  "variables": {
    "resourceSuffix": "[take(uniqueString(subscription().id, parameters('environmentName'), parameters('location')), 6)]",
    "tags": {
